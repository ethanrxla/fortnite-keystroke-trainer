PrincipleCatalog<public>:[]principle_def = array{
    principle_def{Id := "slow_is_smooth", Name := "Accuracy before speed", Rule := "Use a pace where you can place the intended piece, then test it faster.", Why := "Controlled practice makes aim and placement errors easier to notice. Faster reps test whether the movement holds under time pressure.", Creative := "Use your own binds and building settings. Adjust the pace when accuracy drops, and include movement once placement is reliable."},
    principle_def{Id := "cover_first", Name := "Cover the threat", Rule := "Identify the threat direction and place useful cover before exposing yourself.", Why := "A wall helps only when it blocks the relevant angle. Cover placement and your position work together.", Creative := "Choose the piece and order for the threat, terrain and route. A drill sequence is one setup to practise, not a rule for every fight."},
    principle_def{Id := "seal_then_open", Name := "Check before opening", Rule := "Check the exposed angles before opening an edit toward the threat.", Why := "An edit changes who can see and shoot you. Cover on the other sides helps isolate the angle you intend to take.", Creative := "Choose the opening and timing for the situation. Keep a route back to cover instead of enclosing yourself without an exit."},
    principle_def{Id := "reset_always", Name := "Recover cover", Rule := "After a peek, decide whether to reset, reposition or continue the safe angle.", Why := "A reset can close a return-shot angle. Repositioning may be better when the piece is weak or another side is threatened.", Creative := "This drill practises resetting after the peek. In a fight, reassess the threat instead of repeating the sequence automatically."},
    principle_def{Id := "claim_first", Name := "Check piece control", Rule := "Check control of the piece before relying on its edit.", Why := "An edit plan depends on access to the piece and a usable angle. Piece control supports the plan but does not guarantee a safe peek.", Creative := "Choose whether to contest, defend or move to another cell. Track the opponent and your escape route while you build."},
    principle_def{Id := "vary_the_peek", Name := "Read the peek", Rule := "Use cover and crosshair placement, then adapt if the opponent reads your angle.", Why := "Repeated timing can become predictable. A useful peek depends on exposure, target position and whether the opponent is ready.", Creative := "Repeat a stable setup while learning it. Add different angles and timing once you can return to cover reliably."},
    principle_def{Id := "right_tool", Name := "Right tool, ready early", Rule := "Prepare the item for the next action while maintaining useful cover.", Why := "A deliberate swap reduces time spent correcting the selected item and keeps attention on the target.", Creative := "Use a comfortable inventory layout and your preferred input method. Practise finding the intended item without unnecessary cycling."}
}

