FindDrill<public>(Id:string)<decides><transacts>:drill_def =
    (for (D : DrillCatalog, D.Id = Id) { D })[0]

action_hint<public> := struct<computes>:
    Action<public>:string = ""
    Text<public>:string = ""

ActionHints<public>:[]action_hint = array{action_hint{Action := "wall", Text := "Crosshair at chest height on the tile edge you want to block."}, action_hint{Action := "floor", Text := "Look slightly down: crosshair on the tile edge just ahead of your feet."}, action_hint{Action := "ramp", Text := "Face the way you will climb, crosshair on the next tile."}, action_hint{Action := "cone", Text := "Look up so the crosshair is overhead, then place the roof."}, action_hint{Action := "edit", Text := "Edit aim: middle of the wall at chest height. A window is the centre tile."}, action_hint{Action := "edit_confirm", Text := "Confirm while the crosshair is still on the chosen tiles."}, action_hint{Action := "reset", Text := "Reset right after the peek so the wall is whole again."}, action_hint{Action := "jump", Text := "Jump as you place, not before."}, action_hint{Action := "turn_right", Text := "Flick to the next wall while you are in the air."}, action_hint{Action := "fire", Text := "Fire once the crosshair is on the target, not before."}, action_hint{Action := "swap_weapon", Text := "One press of your gun slot, then fire."}, action_hint{Action := "pickaxe", Text := "One press of your pickaxe slot."}}

ActionHintFor<public>(Action:string)<decides><transacts>:string =
    (for (H : ActionHints, H.Action = Action) { H.Text })[0]

