# Crosshair guide for an edit drill. Tiles index the 3x3 wall grid as the player faces it:
# row * 3 + col, row 0 bottom to 2 top, col 0 left to 2 right. Start and End are the tiles the
# crosshair should rest on when edit is pressed and when the drag is released.
edit_guide<public> := struct<computes>:
    DrillId<public>:string = ""
    Tiles<public>:[]int = array{}
    Start<public>:int = 4
    End<public>:int = 4
    GuidedReps<public>:int = 5
    Note<public>:string = ""

EditGuides<public>:[]edit_guide = array{edit_guide{DrillId := "edit_window", Tiles := array{4}, Start := 4, End := 4, GuidedReps := 5, Note := "Crosshair on the ring in the centre tile, then edit. The window is the centre tile only."}, edit_guide{DrillId := "edit_half_wall", Tiles := array{6, 7, 8}, Start := 6, End := 8, GuidedReps := 5, Note := "Start in the top-left tile and drag right between the two red lines, release in the top-right tile."}, edit_guide{DrillId := "edit_reset", Tiles := array{4}, Start := 4, End := 4, GuidedReps := 5, Note := "Crosshair on the ring in the centre tile before you press edit; no travel needed."}, edit_guide{DrillId := "edit_peek", Tiles := array{5}, Start := 5, End := 5, GuidedReps := 5, Note := "Rest the crosshair on the ring in the right-middle tile before editing; peek from the side, not the middle."}}

FindEditGuide<public>(Id:string)<decides><transacts>:edit_guide =
    (for (G : EditGuides, G.DrillId = Id) { G })[0]

FindPrinciple<public>(Id:string)<decides><transacts>:principle_def =
    (for (P : PrincipleCatalog, P.Id = Id) { P })[0]

ChecksForStep<public>(Drill:drill_def, Step:int)<transacts>:[]drill_check =
    for (C : Drill.Checks, C.Step = Step) { C }

edit_route<public> := struct<computes>:
    Name<public>:string = ""
    Tiles<public>:[]int = array{}

