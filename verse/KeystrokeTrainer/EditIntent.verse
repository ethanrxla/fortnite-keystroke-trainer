# GENERATED by tools/gen_intent.py from shared/edit-intent.json. Do not edit by hand.
# The player's aim map: which edit the guide shows for where the crosshair is on the piece (Aim in tiles,
# X right, Y up from the bottom-left as the player sees it). Same rules as the companion (edit_ranker.IntentMap).

using { /UnrealEngine.com/Temporary/SpatialMath }

# The aim map's edit id for this piece and aim point, "" when the map has none (then Jev's ranking alone decides).
KTIntentEdit<public>(Kind:string, Aim:vector2)<transacts>:string =
    if (Kind = "wall") then KTIntentWall(Aim) else ""

KTIntentWall<public>(Aim:vector2)<transacts>:string =
    if (Aim.X < 0.0 or Aim.X >= 3.00 or Aim.Y < 0.0 or Aim.Y >= 3.00):
        return ""
    if (Distance(Aim, vector2{X := 1.00, Y := 1.00}) <= 0.35):
        return "corner_lower_left"
    if (Distance(Aim, vector2{X := 2.00, Y := 1.00}) <= 0.35):
        return "corner_lower_right"
    if (Distance(Aim, vector2{X := 1.00, Y := 2.00}) <= 0.35):
        return "corner_upper_left"
    if (Distance(Aim, vector2{X := 2.00, Y := 2.00}) <= 0.35):
        return "corner_upper_right"
    if (Aim.X >= 2.00, Aim.X < 3.00, Aim.Y >= 1.50, Aim.Y < 2.00):
        return "corner_upper_right"
    if (Aim.X >= 0.00, Aim.X < 1.00, Aim.Y >= 1.50, Aim.Y < 2.00):
        return "corner_upper_left"
    Tiles:[]string = array{"corner_lower_left", "door", "corner_lower_right", "corner_lower_left", "window_center", "corner_lower_right", "corner_upper_left", "half_wall", "corner_upper_right"}
    Col := if (C := Floor[Aim.X]) then Clamp(C, 0, 2) else 0
    Row := if (R := Floor[Aim.Y]) then Clamp(R, 0, 2) else 0
    if (T := Tiles[Row * 3 + Col]) then T else ""
