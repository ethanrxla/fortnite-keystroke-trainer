{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ethanrxla/fortnite-keystroke-trainer/shared/schemas/edit_attempt.v1.json",
  "title": "Edit attempt v1",
  "description": "One edit attempt: from opening edit mode on a piece to confirming, resetting or leaving. Written by the companion (attempt_recorder.py), enriched with key presses by collector.py, uploaded by cloud/sync.py, validated again server-side by the ingest function. All times are wall-clock UTC seconds (acquisition time, not processing time). Values marked inferred came from pose estimation, not from what the game showed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "attempt_id", "session_id", "map_id", "piece", "piece_evidence", "source", "t_edit_open", "t_close", "outcome", "label_status"],
  "properties": {
    "schema": {"const": "edit_attempt.v1"},
    "attempt_id": {"type": "string", "format": "uuid"},
    "session_id": {"type": "string", "maxLength": 64},
    "map_id": {"type": "string", "maxLength": 64},
    "catalog_version": {"type": ["integer", "null"]},
    "policy_version": {"type": ["string", "null"], "maxLength": 64},
    "piece": {"enum": ["wall", "floor", "cone", "ramp", "unknown"]},
    "piece_evidence": {"enum": ["observed", "inferred", "authored"]},
    "source": {"enum": ["screen", "authored"]},
    "suggested_edit_id": {"type": ["string", "null"], "maxLength": 64},
    "suggestion_verified": {"type": "boolean"},
    "picks": {"type": "array", "maxItems": 5, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "cost"],
      "properties": {"id": {"type": "string"}, "cost": {"type": "number"}, "travel": {"type": "number"}, "prior": {"type": "number"}}}},
    "context": {"type": ["object", "null"], "additionalProperties": false, "properties": {
      "aim_uv": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
      "side": {"type": "integer", "minimum": 0, "maximum": 2},
      "far": {"type": "boolean"},
      "distance_cm": {"type": "number"},
      "camera": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
      "body": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
      "inferred": {"type": "boolean"}}},
    "t_edit_open": {"type": "number"},
    "t_first_select": {"type": ["number", "null"]},
    "t_confirm": {"type": ["number", "null"]},
    "t_reset": {"type": ["number", "null"]},
    "t_close": {"type": "number"},
    "selection_trace": {"type": "array", "maxItems": 400, "items": {
      "type": "object", "additionalProperties": false, "required": ["t", "tiles"],
      "properties": {"t": {"type": "number"}, "tiles": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 8}}}}},
    "aim_trace": {"type": "array", "maxItems": 2000, "items": {
      "type": "object", "additionalProperties": false, "required": ["t", "u", "v"],
      "properties": {"t": {"type": "number"}, "u": {"type": "number"}, "v": {"type": "number"}}}},
    "final_tiles": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 8}},
    "matched_edit_id": {"type": ["string", "null"], "maxLength": 64},
    "followed_suggestion": {"type": ["boolean", "null"]},
    "travel": {"type": ["number", "null"]},
    "observation_gaps": {"type": "integer", "minimum": 0},
    "outcome": {"enum": ["completed", "wrong_shape", "reset", "abandoned"]},
    "auto_label_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "label_status": {"enum": ["auto", "approved", "rejected", "relabelled"]},
    "frames": {"type": "array", "maxItems": 3, "items": {"type": "string", "maxLength": 200}}
  }
}
